Cs）、核纤层蛋白等，共同参与染色质的空间组织，影响其致密程度和基因表达 ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"QAmoYvwGCK"},{"type":"citeGroup","kind":"parenthetical","children":[{"type":"cite","kind":"parenthetical","label":"atac:narwade_mapping_2019","identifier":"atac:narwade_mapping_2019","children":[{"type":"text","value":"Narwade ","key":"TmZIBAe2Oe"},{"type":"emphasis","children":[{"type":"text","value":"et al.","key":"htazP3wLox"}],"key":"SnoWaFXcgm"},{"type":"text","value":", 2019","key":"zLqOTcnz1c"}],"enumerator":"1","key":"njCyqWQFuO"},{"type":"cite","kind":"parenthetical","label":"atac:buchwalter_coaching_2019","identifier":"atac:buchwalter_coaching_2019","children":[{"type":"text","value":"Buchwalter ","key":"jD9fQb0aPM"},{"type":"emphasis","children":[{"type":"text","value":"et al.","key":"CV5BBnZJqv"}],"key":"BE28EGkcVo"},{"type":"text","value":", 2019","key":"SX0yxUQOVJ"}],"enumerator":"2","key":"c5c8Mb4kZf"}],"key":"wHglTKyba3"},{"type":"text","value":"。","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"sZgpy6kH8v"},{"type":"strong","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"(2, 3)","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"T19bl9AeXc"}],"key":"Gv23TXCjMP"},{"type":"text","value":" 在局部尺度上，致密的异染色质（heterochromatin）与开放的常染色质（euchromatin）具有不同的可及性。ATP 依赖或非依赖的染色质重塑（chromatin remodeling）复合物，以及乙酰化、甲基化、磷酸化等组蛋白修饰，都能调节这一状态。","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"wOzR8UmzhM"},{"type":"strong","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"(4)","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"T7tjel8sZn"}],"key":"LvI8dQVWGz"},{"type":"text","value":" TF 结合也会影响核小体定位，并招募组蛋白修饰酶与染色质重塑因子。","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"ENUgF2E3ar"},{"type":"strong","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"(5)","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"XNLFfezG6e"}],"key":"GsAUh1h5pq"},{"type":"text","value":" 在 DNA 层面，","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"jGEw7PjHgR"},{"type":"crossReference","label":"CpG","identifier":"term-cpg","children":[{"type":"text","value":"CpG","key":"WaPTx5l6D4"}],"kind":"definitionTerm","template":"{name}","resolved":true,"html_id":"term-cpg","remote":true,"url":"/glossary","dataUrl":"/glossary.json","key":"v58GSbFDAS"},{"type":"text","value":" 位点的甲基化会影响 TF、组蛋白修饰酶等蛋白质的结合亲和力，这些作用可共同促使相应基因组区域沉默。还可观看 ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"UBKzwqwLlG"},{"type":"link","url":"https://www.youtube.com/watch?v=XelGO582s4U","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"这段两分钟动画","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"cMZsI2CcoO"}],"urlSource":"https://www.youtube.com/watch?v=XelGO582s4U","key":"xg8UESQ6DT"},{"type":"text","value":"，了解表观遗传学与基因活性调控（由伊利诺伊大学 SQE 的 Nicole Ethen 制作）。关于基因组调控和 TF 活性的系统综述，可参阅 ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"R820f1VgVB"},{"type":"citeGroup","kind":"parenthetical","children":[{"type":"cite","kind":"parenthetical","label":"atac:isbel_generating_2022","identifier":"atac:isbel_generating_2022","children":[{"type":"text","value":"Isbel ","key":"hHJKuFAzYu"},{"type":"emphasis","children":[{"type":"text","value":"et al.","key":"YiDy2Y6RrU"}],"key":"hPszvJ5jSF"},{"type":"text","value":", 2022","key":"thDgMU1kE2"}],"enumerator":"3","key":"QM8UUQY7pk"}],"key":"lkWVKLzRR3"},{"type":"text","value":"。","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"W2YstCAi6l"}],"key":"sDQoVPUPJK"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"细胞的调控状态是决定细胞身份的重要因素。本部分聚焦染色质可及性数据，主要来自 ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"NBzTL21A3v"},{"type":"strong","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"单细胞转座酶可及染色质测序（single-cell assay for transposase-accessible chromatin using sequencing, scATAC-seq）","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"Ck2qEQl1Ia"}],"key":"eedEhM89EW"},{"type":"text","value":"，也包括 ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"UuQzxFxx8a"},{"type":"strong","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"10x Multiome 测定（Assay，在同一细胞核中联合测量染色质可及性与 RNA）","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"Yds8wjwq9L"}],"key":"jqor0jyDXK"},{"type":"text","value":"。","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"LTYngt07vo"}],"key":"RoAJofzewS"},{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"完成预处理后，可以利用这些数据：","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"RbI8lUi93x"}],"key":"ar2ORRuOTs"},{"type":"list","ordered":true,"start":1,"spread":false,"position":{"start":{"line":6,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"从不同于 scRNA-seq 的角度刻画细胞身份","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"BtHDsTVgNd"}],"key":"hgZcZQhzOY"}],"key":"QWtYkn8cUT"},{"type":"listItem","spread":true,"position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"识别细胞状态特异的转录调控因子","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"q88HHKhwFT"}],"key":"kJxWtFm484"}],"key":"MRZtIllu1L"},{"type":"listItem","spread":true,"position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"将基因表达与序列特征（sequence feature）联系起来","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"key":"WNEGPSxCHk"}],"key":"HOwdvlv1KL"}],"key":"CrdkXpRnm9"},{"type":"listItem","spread":true,"position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"解析驱动细胞分化和疾病状态的表观遗传机制","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"l7cbD4sz31"}],"key":"nU0Rwpv9bc"}],"key":"HkOxXCsbgR"}],"key":"RYGYIilQEi"}],"visibility":"show","key":"mHDqYEvv1G"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"实验方法","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"p70gandgTO"}],"identifier":"experimental-assay","label":"Experimental assay","html_id":"experimental-assay","implicit":true,"key":"utRNqwNrBE"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"商用试剂盒是目前广泛采用的实验方案。本书以 10x Multiome 数据演示分析；稍作调整后，同样适用于单模态 10x 单细胞 ATAC-seq 数据。","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"ODhav1xIsA"}],"key":"SIW9xy2Upi"},{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"text","value":"转座酶可及染色质测序（assay for transposase-accessible chromatin with high-throughput sequencing, ATAC-seq） 利用 Tn5 转座酶探测开放染色质。以目标组织的单细胞悬液为起点，先提取细胞核，再在 bulk 条件下进行转座反应：Tn5 结合开放区域，同时切割 DNA 并接入测序接头。随后将细胞核加载到 10x Chromium Controller，生成包裹凝胶珠和单个细胞核的乳液微滴（Gel Bead-in-Emulsion, GEM）。微滴内的 RNA 分子和 DNA 片段被加上条形码（Barcode）；破乳后再进行预扩增及后续建库，得到 scATAC-seq 和 RNA 测序文库（library）。","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"fU5z5lRcOX"}],"key":"rs7WuxFs2C"},{"type":"paragraph","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"text","value":"下图展示了 scATAC-seq 的 DNA 片段化过程 ","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"key":"nOJB0x8dfy"},{"type":"citeGroup","kind":"parenthetical","children":[{"type":"cite","kind":"parenthetical","label":"atac:martens_modeling_2022","identifier":"atac:martens_modeling_2022","children":[{"type":"text","value":"Martens ","key":"baN9FJpazM"},{"type":"emphasis","children":[{"type":"text","value":"et al.","key":"ve2dhgH0Si"}],"key":"BiOg6NlWDN"},{"type":"text","value":", 2022","key":"BGQKxcpd0w"}],"enumerator":"4","key":"bFVhRWCS3z"}],"key":"aBCyNN2wv6"},{"type":"text","value":"。Tn5 在开放染色质区域切割 DNA 并插入测序接头。两次插入可形成一个两端带接头的片段；插入方向十分重要，因为只有两端携带不同接头的片段才能被捕获并扩增。扩增后的片段经过双端测序（paired-end sequencing），再比对到参考基因组（reference genome）。","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"key":"pzSJXPs6MD"}],"key":"Q7WRHnjU5j"}],"key":"qPCysUDFax"},{"type":"block","kind":"notebook-content","children":[{"type":"container","kind":"figure","children":[{"type":"image","url":"/single-cell-best-practices-zh/build/mechanisms_overview-30644a3e96c24654066548c29faebc4f.png","alt":"ATAC-seq 流程概览","width":"800px","key":"aj4rXNyeF1","urlSource":"../_static/images/sc_atac/mechanisms_overview.png"},{"type":"caption","children":[{"type":"paragraph","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"captionNumber","kind":"figure","label":"ATAC-seq_overview","identifier":"atac-seq_overview","html_id":"atac-seq-overview","enumerator":"2","children":[{"type":"text","value":"图 ","key":"bymGyPHfdz"},{"type":"text","value":"2","key":"RaJMXq1fbA"},{"type":"text","value":"：","key":"nSGeBsIGc4"}],"template":"图 %s：","key":"tDtDwxauC5"},{"type":"text","value":"ATAC-seq 流程概览。图片来源：","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"KYhOElb2MK"},{"type":"citeGroup","kind":"parenthetical","children":[{"type":"cite","kind":"parenthetical","label":"atac:martens_modeling_2022","identifier":"atac:martens_modeling_2022","children":[{"type":"text","value":"Martens ","key":"xKYVV12XXr"},{"type":"emphasis","children":[{"type":"text","value":"et al.","key":"zTOD7z8fgh"}],"key":"YPR8EQjsmd"},{"type":"text","value":", 2022","key":"zgsHdRrkLR"}],"enumerator":"4","key":"c8fV9DvaRN"}],"key":"IsPlFAjkuc"},{"type":"text","value":"。","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"w0p2MzpsKH"}],"key":"eMbcy8wJIC"}],"key":"PYnreqIawL"}],"class":"bg-primary mb-1","label":"ATAC-seq_overview","identifier":"atac-seq_overview","enumerator":"2","html_id":"atac-seq-overview","key":"ZRyvRqhSNA"}],"key":"QovAdxNmgZ"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"数据特点：feature 定义与稀疏性","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"S9Pv5tnWxp"}],"label":"chromatin-accessibility-introduction-key-takeaway-2","identifier":"chromatin-accessibility-introduction-key-takeaway-2","html_id":"chromatin-accessibility-introduction-key-takeaway-2","key":"c7hkyEEwDH"},{"type":"paragraph","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"text","value":"scATAC-seq 覆盖整个基因组的编码区和非编码区，因此通常不能像 scRNA-seq 那样直接把基因作为预定义 特征（feature）。常见做法是寻找可及性高于背景的区域，也就是基因组上片段计数（Count）分布中的峰（peak）。基因区域的开放状态可提示转录潜能；非编码区的开放状态则可能是 TF 等调控蛋白结合的前提或结果。若汇总所有细胞后统一识别峰（peak calling），细胞类型特异的信号和稀有群体的信号可能被掩盖。为此，可以先在不依赖峰的表示上对细胞聚类（clustering），再分别识别各簇的峰。SnapATAC","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"Tw8ZLWBJAy"},{"type":"citeGroup","kind":"parenthetical","children":[{"type":"cite","kind":"parenthetical","label":"atac:fang_comprehensive_2021","identifier":"atac:fang_comprehensive_2021","children":[{"type":"text","value":"Fang ","key":"yC1JEvcCFx"},{"type":"emphasis","children":[{"type":"text","value":"et al.","key":"s8hAMt8lIZ"}],"key":"Zg0azVXG7S"},{"type":"text","value":", 2021","key":"BOHd7mEUks"}],"enumerator":"5","key":"Jfc3s4ixsC"}],"key":"nzFYynIReO"},{"type":"text","value":" 和 ArchR","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"lxNCU2sgcB"},{"type":"citeGroup","kind":"parenthetical","children":[{"type":"cite","kind":"parenthetical","label":"atac:granja_archr_2021","identifier":"atac:granja_archr_2021","children":[{"type":"text","value":"Granja ","key":"k2KWntr7EB"},{"type":"emphasis","children":[{"type":"text","value":"et al.","key":"pmgvZWmr6V"}],"key":"FQJnS45Pup"},{"type":"text","value":", 2021","key":"MwZswmbsQV"}],"enumerator":"6","key":"Niz9TAsH0A"}],"key":"UwIvAGoCgj"},{"type":"text","value":" 提出了基因组分箱（binning）策略：将整个基因组划分为等长窗口（bin），把这些窗口作为 feature 用于细胞聚类。","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"UZB01wWaEX"}],"key":"KAVKKiXUzc"},{"type":"paragraph","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"text","value":"定义 feature 集合后，需要量化每个细胞在各 feature 中的 Tn5 信号。主要有三种策略：统计重叠的读段（Read）数、统计重叠的片段数，或将信号二值化（binarization）。10x Genomics 的 Cell Ranger ATAC 流程（pipeline）统计峰区域内的 Read，而 Signac ","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"hUfi0gNFp6"},{"type":"citeGroup","kind":"parenthetical","children":[{"type":"cite","kind":"parenthetical","label":"atac:stuart_multimodal_2020","identifier":"atac:stuart_multimodal_2020","children":[{"type":"text","value":"Stuart ","key":"NsnOArOWc5"},{"type":"emphasis","children":[{"type":"text","value":"et al.","key":"SdjAwmcXFl"}],"key":"hQjGfSz18q"},{"type":"text","value":", 2020","key":"tRlhNcYlwt"}],"enumerator":"7","key":"sT20oIQxTn"}],"key":"NW9tnq6Du3"},{"type":"text","value":" 统计与 feature 重叠的片段。ArchR ","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"hJL6kzoatg"},{"type":"citeGroup","kind":"parenthetical","children":[{"type":"cite","kind":"parenthetical","label":"atac:granja_archr_2021","identifier":"atac:granja_archr_2021","children":[{"type":"text","value":"Granja ","key":"BBu1Za7diI"},{"type":"emphasis","children":[{"type":"text","value":"et al.","key":"pReyqhZwcG"}],"key":"impjZi0lT2"},{"type":"text","value":", 2021","key":"ZDQrdkdZ7b"}],"enumerator":"6","key":"yPYhU2yESK"}],"key":"YkomoR1ZDv"},{"type":"text","value":" 则统计 Read 末端，并在相应的默认分析流程中使用二值化表示。","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"srKw7tsTsd"}],"key":"oBnVLn7CUW"},{"type":"paragraph","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"text","value":"按 Read 或片段计数会得到不同的 Count 分布。scATAC-seq 的双端测序为每个片段产生一对通常相距较近的 Read；若两端都落在同一 feature 内，该片段就贡献两个 Read。只有一端落在 feature 内时，才可能产生奇数 Count ","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"key":"crwSCJ5MYn"},{"type":"citeGroup","kind":"parenthetical","children":[{"type":"cite","kind":"parenthetical","label":"atac:martens_modeling_2022","identifier":"atac:martens_modeling_2022","children":[{"type":"text","value":"Martens ","key":"UFYBx2ivp0"},{"type":"emphasis","children":[{"type":"text","value":"et al.","key":"QzyB8DpNdI"}],"key":"ecXJ8inKrS"},{"type":"text","value":", 2022","key":"gBFUkiiF7P"}],"enumerator":"4","key":"qtoBNAktcg"}],"key":"xgjWnl7bYA"},{"type":"text","value":"。因此，按 Read 计数时，偶数 Count 往往远多于奇数 Count；按片段计数则没有这种成对累加的效应 ","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"key":"i8UcD32xia"},{"type":"citeGroup","kind":"parenthetical","children":[{"type":"cite","kind":"parenthetical","label":"atac:martens_modeling_2022","identifier":"atac:martens_modeling_2022","children":[{"type":"text","value":"Martens ","key":"ZuNZ5JynW1"},{"type":"emphasis","children":[{"type":"text","valu