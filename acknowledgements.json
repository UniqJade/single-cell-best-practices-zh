{"version":3,"kind":"Article","sha256":"7c6c538ddbd5367dc402f48c431389a5f4288b77e0d9057e7ec252c86d06edec","slug":"acknowledgements","location":"/acknowledgements.md","dependencies":[],"frontmatter":{"title":"致谢","numbering":{"all":{"enabled":false},"title":{"offset":1}},"content_includes_title":false,"authors":[{"nameParsed":{"literal":"Lukas Heumos","given":"Lukas","family":"Heumos"},"name":"Lukas Heumos","id":"contributors-myst-generated-uid-0"},{"nameParsed":{"literal":"Anna Schaar","given":"Anna","family":"Schaar"},"name":"Anna Schaar","id":"contributors-myst-generated-uid-1"},{"nameParsed":{"literal":"single-cell best practices consortium","given":"single-cell","non_dropping_particle":"best practices","family":"consortium"},"name":"single-cell best practices consortium","id":"contributors-myst-generated-uid-2"}],"github":"https://github.com/theislab/single-cell-best-practices","settings":{"output_matplotlib_strings":"remove"},"source_url":"https://github.com/theislab/single-cell-best-practices/blob/main/.build/v2-candidate/production-2026-09-12-01/overlay/acknowledgements.md","edit_url":"https://github.com/theislab/single-cell-best-practices/edit/main/.build/v2-candidate/production-2026-09-12-01/overlay/acknowledgements.md","exports":[{"format":"md","filename":"acknowledgements.md","url":"/single-cell-best-practices-zh/build/acknowledgements-b216cdfcaadc7d0d46e11db7f4ed979d.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"paragraph","position":{"start":{"line":7,"column":1},"end":{"line":12,"column":1}},"children":[{"type":"text","value":"我们很容易忘记，科学上许多重大进展，往往源自过去一些看似不起眼的实验。整个单细胞领域都建立在生物学和计算机科学数十年的基础研究之上。没有基础的测序技术和原始数据处理技术，我们甚至不会设想对单细胞进行测序。试想，如果没有用于预处理和可视化的基础算法，今天我们也无法对单细胞数据做无监督分析。可是，这些算法不仅需要在理论上被提出，还需要变得易于获取、可复用，服务于所有用户；这之所以可能，正是因为许多勤奋的学生投入时间开发和维护这些框架与工具。我们站在巨人的肩膀上，也很自豪能贡献一份微薄力量，帮助用户有效分析单细胞数据。","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"rEx4i6sI70"}],"key":"raR5nHwnIU"},{"type":"paragraph","positi