ne":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"(5)","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"HDgEZo1S8U"}],"key":"ii6NSyfrBr"},{"type":"text","value":" 在 DNA 层面，","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"D1rX98zznf"},{"type":"crossReference","label":"CpG","identifier":"term-cpg","children":[{"type":"text","value":"CpG","key":"nVlgLq2MDS"}],"kind":"definitionTerm","template":"{name}","resolved":true,"html_id":"term-cpg","remote":true,"url":"/glossary","dataUrl":"/glossary.json","key":"mlv2mDzEUi"},{"type":"text","value":" 位点的甲基化会影响 TF、组蛋白修饰酶等蛋白质的结合亲和力，这些作用可共同促使相应基因组区域沉默。还可观看 ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"HDOoNcETHh"},{"type":"link","url":"https://www.youtube.com/watch?v=XelGO582s4U","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"这段两分钟动画","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"CUUGrShNjh"}],"urlSource":"https://www.youtube.com/watch?v=XelGO582s4U","key":"sJM4L376tZ"},{"type":"text","value":"，了解表观遗传学与基因活性调控（由伊利诺伊大学 SQE 的 Nicole Ethen 制作）。关于基因组调控和 TF 活性的系统综述，可参阅 ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"UlPUMxi44W"},{"type":"citeGroup","kind":"parenthetical","children":[{"type":"cite","kind":"parenthetical","label":"atac:isbel_generating_2022","identifier":"atac:isbel_generating_2022","children":[{"type":"text","value":"Isbel ","key":"gpBsBqmCz4"},{"type":"emphasis","children":[{"type":"text","value":"et al.","key":"vBac6vVoAa"}],"key":"C1TRKGvj6B"},{"type":"text","value":", 2022","key":"UnxJjmqQnd"}],"enumerator":"3","key":"sz9V82pt5J"}],"key":"J5LCFEhfgy"},{"type":"text","value":"。","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"mVX1164trf"}],"key":"HogTCcK00M"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"细胞的调控状态是决定细胞身份的重要因素。本部分聚焦染色质可及性数据，主要来自 ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"wQQilPiJI8"},{"type":"strong","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"单细胞转座酶可及染色质测序（single-cell assay for transposase-accessible chromatin using sequencing, scATAC-seq）","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"wcBUlpiBBV"}],"key":"WHKIT273Im"},{"type":"text","value":"，也包括 ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"VxZpKZbWsa"},{"type":"strong","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"10x Multiome 测定（Assay，在同一细胞核中联合测量染色质可及性与 RNA）","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"mlx5s5t0Mi"}],"key":"fJRpa0y3UA"},{"type":"text","value":"。","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"BH7M70w3Ly"}],"key":"hdApjSjFdL"},{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"完成预处理后，可以利用这些数据：","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"v2NCFm10lp"}],"key":"ihNLvvqS4n"},{"type":"list","ordered":true,"start":1,"spread":false,"position":{"start":{"line":6,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"从不同于 scRNA-seq 的角度刻画细胞身份","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"H30GvvCEJu"}],"key":"kZC1j3IlxF"}],"key":"dCcgx8P3PO"},{"type":"listItem","spread":true,"position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"识别细胞状态特异的转录调控因子","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"nA5QOtTYd2"}],"key":"ROVXk68flW"}],"key":"CRuhN5krtb"},{"type":"listItem","spread":true,"position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"将基因表达与序列特征（sequence feature）联系起来","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"key":"dOrocAqn2r"}],"key":"ZJNy0GUnWw"}],"key":"ZJwFxtKE6A"},{"type":"listItem","spread":true,"position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"解析驱动细胞分化和疾病状态的表观遗传机制","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"dxUDGJHJH6"}],"key":"doNYyIM0Ic"}],"key":"NURhNMQGQM"}],"key":"AmFEiN4YWc"}],"visibility":"show","key":"nynoC0MLQG"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"实验方法","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"ndIoe7PHCE"}],"identifier":"experimental-assay","label":"Experimental assay","html_id":"experimental-assay","implicit":true,"key":"bC7k2ZQDg0"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"商用试剂盒是目前广泛采用的实验方案。本书以 10x Multiome 数据演示分析；稍作调整后，同样适用于单模态 10x 单细胞 ATAC-seq 数据。","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"UxBi4Ejrq3"}],"key":"A85ufv9au0"},{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"text","value":"转座酶可及染色质测序（assay for transposase-accessible chromatin with high-throughput sequencing, ATAC-seq） 利用 Tn5 转座酶探测开放染色质。以目标组织的单细胞悬液为起点，先提取细胞核，再在 bulk 条件下进行转座反应：Tn5 结合开放区域，同时切割 DNA 并接入测序接头。随后将细胞核加载到 10x Chromium Controller，生成包裹凝胶珠和单个细胞核的乳液微滴（Gel Bead-in-Emulsion, GEM）。微滴内的 RNA 分子和 DNA 片段被加上条形码（Barcode）；破乳后再进行预扩增及后续建库，得到 scATAC-seq 和 RNA 测序文库（library）。","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"x11R9VDGqf"}],"key":"XjIU1wXevl"},{"type":"paragraph","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"text","value":"下图展示了 scATAC-seq 的 DNA 片段化过程 ","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"key":"ggIAzEe0uI"},{"type":"citeGroup","kind":"parenthetical","children":[{"type":"cite","kind":"parenthetical","label":"atac:martens_modeling_2022","identifier":"atac:martens_modeling_2022","children":[{"type":"text","value":"Martens ","key":"ePsEjeLQgg"},{"type":"emphasis","children":[{"type":"text","value":"et al.","key":"F7usRxwJ08"}],"key":"muXWU1rZVV"},{"type":"text","value":", 2022","key":"qQxBHYZX5h"}],"enumerator":"4","key":"t0q7DYyCEF"}],"key":"mCRx9lISgJ"},{"type":"text","value":"。Tn5 在开放染色质区域切割 DNA 并插入测序接头。两次插入可形成一个两端带接头的片段；插入方向十分重要，因为只有两端携带不同接头的片段才能被捕获并扩增。扩增后的片段经过双端测序（paired-end sequencing），再比对到参考基因组（reference genome）。","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"key":"uKAqjROjRh"}],"key":"OM8EUdgFfT"}],"key":"wkZLOf44VZ"},{"type":"block","kind":"notebook-content","children":[{"type":"container","kind":"figure","children":[{"type":"image","url":"/single-cell-best-practices-zh/build/mechanisms_overview-19b52ba25d649578d0ee1040ca5166c9.png","alt":"ATAC-seq 流程概览","width":"800px","key":"E94Hv6jOo7","urlSource":"../_static/images/sc_atac/mechanisms_overview.png"},{"type":"caption","children":[{"type":"paragraph","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"captionNumber","kind":"figure","label":"ATAC-seq_overview","identifier":"atac-seq_overview","html_id":"atac-seq-overview","enumerator":"2","children":[{"type":"text","value":"图 ","key":"FWqzQEYBMP"},{"type":"text","value":"2","key":"Ol9b92nz6A"},{"type":"text","value":"：","key":"eNF58mcVJP"}],"template":"图 %s：","key":"ESRdPv4ZWn"},{"type":"text","value":"ATAC-seq 流程概览。图片来源：","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"ogVCbSB0sr"},{"type":"citeGroup","kind":"parenthetical","children":[{"type":"cite","kind":"parenthetical","label":"atac:martens_modeling_2022","identifier":"atac:martens_modeling_2022","children":[{"type":"text","value":"Martens ","key":"VpbeoVk0oz"},{"type":"emphasis","children":[{"type":"text","value":"et al.","key":"n1AYESLMMw"}],"key":"zXpHBkjV7R"},{"type":"text","value":", 2022","key":"Mqx6owryYs"}],"enumerator":"4","key":"TA5NRWh6r9"}],"key":"xZDsR5JCVA"},{"type":"text","value":"。","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"QPy0WHT7hR"}],"key":"w4EvxUwX7G"}],"key":"diGNAeNCMn"}],"class":"bg-primary mb-1","label":"ATAC-seq_overview","identifier":"atac-seq_overview","enumerator":"2","html_id":"atac-seq-overview","key":"DPRdW15PME"}],"key":"VKqNm3FHci"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"数据特点：feature 定义与稀疏性","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"mruMjW67xz"}],"label":"chromatin-accessibility-introduction-key-takeaway-2","identifier":"chromatin-accessibility-introduction-key-takeaway-2","html_id":"chromatin-accessibility-introduction-key-takeaway-2","key":"KY2yMBhzbi"},{"type":"paragraph","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"text","value":"scATAC-seq 覆盖整个基因组的编码区和非编码区，因此通常不能像 scRNA-seq 那样直接把基因作为预定义 特征（feature）。常见做法是寻找可及性高于背景的区域，也就是基因组上片段计数（Count）分布中的峰（peak）。基因区域的开放状态可提示转录潜能；非编码区的开放状态则可能是 TF 等调控蛋白结合的前提或结果。若汇总所有细胞后统一识别峰（peak calling），细胞类型特异的信号和稀有群体的信号可能被掩盖。为此，可以先在不依赖峰的表示上对细胞聚类（clustering），再分别识别各簇的峰。SnapATAC","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"mf1WoQaWBF"},{"type":"citeGroup","kind":"parenthetical","children":[{"type":"cite","kind":"parenthetical","label":"atac:fang_comprehensive_2021","identifier":"atac:fang_comprehensive_2021","children":[{"type":"text","value":"Fang ","key":"kmePTZTuyR"},{"type":"emphasis","children":[{"type":"text","value":"et al.","key":"Q6NMeQcdaP"}],"key":"U61LRFjidE"},{"type":"text","value":", 2021","key":"wWaWESpefy"}],"enumerator":"5","key":"ZbFVGByhaE"}],"key":"pywv99mQzA"},{"type":"text","value":" 和 ArchR","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"jCut7mdrVs"},{"type":"citeGroup","kind":"parenthetical","children":[{"type":"cite","kind":"parenthetical","label":"atac:granja_archr_2021","identifier":"atac:granja_archr_2021","children":[{"type":"text","value":"Granja ","key":"PyyRjK871K"},{"type":"emphasis","children":[{"type":"text","value":"et al.","key":"Wy7yPKOuja"}],"key":"n39AaljJZL"},{"type":"text","value":", 2021","key":"adizKzxQh8"}],"enumerator":"6","key":"IYfYsMEgmc"}],"key":"sNUi0dSVmn"},{"type":"text","value":" 提出了基因组分箱（binning）策略：将整个基因组划分为等长窗口（bin），把这些窗口作为 feature 用于细胞聚类。","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"jReB4SUcy7"}],"key":"IFaEz0uCwi"},{"type":"paragraph","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"text","value":"定义 feature 集合后，需要量化每个细胞在各 feature 中的 Tn5 信号。主要有三种策略：统计重叠的读段（Read）数、统计重叠的片段数，或将信号二值化（binarization）。10x Genomics 的 Cell Ranger ATAC 流程（pipeline）统计峰区域内的 Read，而 Signac ","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"WZIRfFUkmC"},{"type":"citeGroup","kind":"parenthetical","children":[{"type":"cite","kind":"parenthetical","label":"atac:stuart_multimodal_2020","identifier":"atac:stuart_multimodal_2020","children":[{"type":"text","value":"Stuart ","key":"f3fNAyOmxW"},{"type":"emphasis","children":[{"type":"text","value":"et al.","key":"Uu2WIBjX2V"}],"key":"h2LeuKGO2y"},{"type":"text","value":", 2020","key":"N62VHIGnAy"}],"enumerator":"7","key":"DF4CKKD5a4"}],"key":"eniIZO37U6"},{"type":"text","value":" 统计与 feature 重叠的片段。ArchR ","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"X1K5ZMA9nX"},{"type":"citeGroup","kind":"parenthetical","children":[{"type":"cite","kind":"parenthetical","label":"atac:granja_archr_2021","identifier":"atac:granja_archr_2021","children":[{"type":"text","value":"Granja ","key":"T35biVsimG"},{"type":"emphasis","children":[{"type":"text","value":"et al.","key":"sKRtTUhm7Y"}],"key":"imyBXgYPiJ"},{"type":"text","value":", 2021","key":"hKjEZlER4n"}],"enumerator":"6","key":"wiwmjjweBh"}],"key":"ZXQWIfH942"},{"type":"text","value":" 则统计 Read 末端，并在相应的默认分析流程中使用二值化表示。","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"uEk9RRGkjS"}],"key":"nJpKFDsbXV"},{"type":"paragraph","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"text","value":"按 Read 或片段计数会得到不同的 Count 分布。scATAC-seq 的双端测序为每个片段产生一对通常相距较近的 Read；若两端都落在同一 feature 内，该片段就贡献两个 Read。只有一端落在 feature 内时，才可能产生奇数 Count ","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"key":"HKoKOp9H9o"},{"type":"citeGroup","kind":"parenthetical","children":[{"type":"cite","kind":"parenthetical","label":"atac:martens_modeling_2022","identifier":"atac:martens_modeling_2022","children":[{"type":"text","value":"Martens ","key":"eCG17anAKC"},{"type":"emphasis","children":[{"type":"text","value":"et al.","key":"kZ0m7iRP2n"}],"key":"NRNu55XGJQ"},{"type":"text","value":", 2022","key":"M4F0kwUnU3"}],"enumerator":"4","key":"F0jkead49t"}],"key":"iPGavxw4mA"},{"type":"text","value":"。因此，按 Read 计数时，偶数 Count 往往远多于奇数 Count；按片段计数则没有这种成对累加的效应 ","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"key":"eFw2ofUHJ4"},{"type":"citeGroup","kind":"parenthetical","children":[{"type":"cite","kind":"parenthetical","label":"atac:martens_modeling_2022","identifier":"atac:martens_modeling_2022","children":[{"type":"text","value":"Martens ","key":"yGo5o1EXUW"},{"type":"emphasis","children":[{"type":"text","value":"et al.","key":"xeDg5jZwBi"}],"key":"amUkgCcrCJ"},{"type":"text","value":", 2022","key":"ZYtlVOtaBa"}],"enumerator":"4","key":"eEoeQSaBD0"},{"type":"cite","kind":"parenthetical","label":"atac:miao_is_2022","identifier":"atac:miao_is_2022","children":[{"type":"text","value":"Miao & Kim, 2022","key":"FhMCu7nxMo"}],"enumerator":"8","key":"UDN28keoaP"}],"key":"mIboXYYCpB"},{"type":"text","value":"。","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"key":"MvvtuyhlKv"}],"key":"YqCIVdFhEw"},{"type":"paragraph","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"children":[{"type":"text","value":"scATAC-seq 数据还具有很高的稀疏性。在未复制、无拷贝数变异的二倍体常染色体区域，每个位点通常只有两份 DNA 模板，可贡献的独立片段数十分有限；峰或 bin 跨越较长区域，其 Count 则可大于 2。有限的模板和捕获效率使许多 feature 的 Count 为零，形成高度稀疏的计数矩阵（Count matrix）。一些方法将 Count 二值化：只要有一个 Read 或片段与 feature 重叠，就将其记为可及 ","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"key":"Af1EejqBlV"},{"type":"citeGroup","kind":"parenthetical","children":[{"type":"cite","kind":"parenthetical","label":"atac:granja_archr_2021","identifier":"atac:granja_archr_2021","children":[{"type":"text","value":"Granja ","key":"lOw0fMQ7J3"},{"type":"emphasis","children":[{"type":"text","value":"et al.","key":"j2EFkKgx3Q"}],"key":"Hh2n2eU4Xd"},{"type":"text","value":", 2021","key":"HSVPic2iV2"}],"enumerator":"6","key":"KqFk70thJY"},{"type":"cite","kind":"parenthetical","label":"atac:bravo_gonzalez-blas_cistopic_2019","identifier":"atac:bravo_gonzalez-blas_cistopic_2019","children":[{"type":"text","value":"Bravo González-Blas ","key":"VAiFZiPJAL"},{"type":"emphasis","children":[{"type":"text","value":"et al.","key":"v0pv58tA3u"}],"key":"ckXOpuhjjF"},{"type":"text","value":", 2019","key":"Uk9l7ZPBuU"}],"enumerator":"9","key":"Jo4Dtn2Yx0"},{"type":"cite","kind":"parenthetical","label":"atac:bravo_gonzalez-blas_cistopic_2019","identifier":"atac:bravo_gonzalez-blas_cistopic_2019","children":[{"type":"text","value":"Bravo González-Blas ","key":"KIGefSndWz"},{"t